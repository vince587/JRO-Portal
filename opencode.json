        "nvidia/nemotron-3-nano-omni": { "name": "Nemotron 3 Nano Omni" },
        "nvidia/nemotron-3-super": { "name": "Nemotron 3 Super" },
        "nvidia/nemotron-3-ultra": { "name": "Nemotron 3 Ultra" },
        "x-ai/grok-4.5": { "name": "Grok 4.5" },
        "x-ai/grok-4.6": { "name": "Grok 4.6" },
        "x-ai/grok-build-0.1": { "name": "Grok Build 0.1" }
      }
