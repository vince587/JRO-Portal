# Frontend (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Firebase web API key (same as VITE_FIREBASE_API_KEY). Required for server-side
# password re-verification (change-password, self-service password update).
FIREBASE_API_KEY=

# Session cookie signing secret. REQUIRED in production — the server refuses to
# start without it. Use a long random value (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Comma-separated list of allowed web origins for CORS (e.g.
# http://localhost:5173,https://portal.jmcs.example.com). If empty, no
# cross-origin requests are allowed.
CORS_ORIGINS=

# Max concurrent SSE connections (default 200).
MAX_SSE_CLIENTS=200

# Email (Resend SMTP) — used to email external training access links
RESEND_API_KEY=
MAIL_FROM=JMCS Portal <onboarding@resend.dev>
# Optional overrides
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
# Public base URL used in emailed links (e.g. https://portal.jmcs.example.com)
PUBLIC_URL=https://software-jmcs.web.app
PUBLIC_REDIRECT_URL=https://materials.jro-jmcs.com
PUBLIC_VIEWER_URL=https://materials.jro-jmcs.com
