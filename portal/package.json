{
  "name": "@workspace/internal-portal",
  "version": "1.2.3",
  "private": true,
  "description": "Internal Portal - Certificate and Records Management System",
  "author": "JMCS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "copy-installer": "node scripts/copy-installer.cjs",
    "deploy": "firebase deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "electron:dev": "concurrently --kill-others \"cd ../api-server && npm run dev\" \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "node ../api-server/build.mjs && vite build --config vite.electron.config.ts && electron-builder && node scripts/copy-installer.cjs",
    "electron:package": "node ../api-server/build.mjs && vite build --config vite.electron.config.ts && electron-builder && node scripts/copy-installer.cjs",
    "build:desktop": "vite build --config vite.config.ts && node scripts/package-desktop.cjs",
    "release": "npm run build && npm run electron:package && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.5.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "vite": "^7.3.2",
    "vite-plugin-singlefile": "^2.3.0",
    "wait-on": "^9.0.10",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.jmcs.internal-portal",
    "productName": "Internal Portal",
    "directories": {
      "output": "release"
    },
    "icon": "public/logo.ico",
    "win": {
      "icon": "public/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "public/logo.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "protocols": {
      "name": "JMCS Protocol",
      "schemes": ["jmcs"]
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://software-jmcs.web.app/downloads/"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../api-server/dist",
        "to": "api-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../api-server/node_modules",
        "to": "api-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../api-server/.env",
        "to": "api-server/.env"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "qrcode": "^1.5.4",
    "react-data-grid": "^7.0.0-beta.59",
    "xlsx": "^0.18.5"
  }
}
